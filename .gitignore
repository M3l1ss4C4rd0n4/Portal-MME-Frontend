# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Graphify cache (regenerado automaticamente con `graphify update .`)
graphify-out/cache/
graphify-out/*.bak
graphify-out/*.bak.*
graphify-out/*.pre-*
# Claude Code session data
.claude/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next.bak*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Build artifacts
dist.bak/
dist/
_next/

# Next.js RSC payloads y archivos generados (export estático)
__next.*.txt
**/__next.*.txt
**/index.html
**/index.txt
404.html
index.html
index.txt

# Imágenes y fuentes públicas generadas (no rastrear binarios)
public/images/
**/*.woff2
**/*.woff

# Logs
logs/

# Exceptuar logos SVG (manuales)
!public/images/logos/
!public/images/logos/*.svg
# Carpeta local de informes PDF — no debe incluir venv Python dentro del repo Next
informes del mes/venv/
informes del mes/**/venv/
venv/
venv_*/
.venv/
