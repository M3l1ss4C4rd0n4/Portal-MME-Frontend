"use client";

import { useState, useEffect } from "react";
import { motion } from "framer-motion";
import { ResponsiveBar } from "@nivo/bar";
import { ResponsivePie } from "@nivo/pie";
import { ResponsiveLine } from "@nivo/line";
import { useTheme } from "@/providers/ThemeProvider";
import DashboardLayout from "@/components/DashboardLayout";

import { getNivoTheme } from "@/lib/nivo-theme";

// ─── Helpers ──────────────────────────────────────────────────────────────
function Card({ children, className = "", delay = 0 }: { children: React.ReactNode; className?: string; delay?: number }) {
  return (
    <motion.div initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ duration: 0.5, delay }}
      className={`bg-theme-secondary border border-theme-card rounded-2xl p-5 hover:border-amber-500/40 transition-colors duration-300 ${className}`}>
      {children}
    </motion.div>
  );
}
function KpiChip({ label, value, sub, accent = false }: { label: string; value: string | number; sub?: string; accent?: boolean }) {
  return (
    <div className="bg-dash-chip rounded-xl px-3 py-2.5">
      <div className={`text-base font-bold leading-none ${accent ? "text-amber-400" : "text-theme-primary"}`}>{value}</div>
      {sub && <div className="text-[9px] text-amber-400/70 mt-0.5">{sub}</div>}
      <div className="text-[10px] text-theme-muted mt-1 leading-tight">{label}</div>
    </div>
  );
}
const fmtCOP = (v: number) => `$ ${Math.round(v).toLocaleString("es-CO")}`;
const fmtBFull = fmtCOP;

// ─── Types ────────────────────────────────────────────────────────────────
interface YearBlock { resoluciones: number; valorAsignado: number; pendiente: number; pagado: number }
interface HistoricoRow { anio: number; fondo: string; valor_asignado: number; pagado: number; pendiente: number }
interface DeficitHistoricoRow {
  anio: number;
  subsidios: number;
  contribuciones: number;
  deficit_anual: number;
  deficit_acumulado: number;
  apropiacion_pgn: number;
  recursos_faltantes: number;
}
interface SubsidiosData {
  deficitAcumulado: number;
  anio2025: YearBlock;
  anio2026: YearBlock;
  historico: HistoricoRow[];
}
const DEFAULT: SubsidiosData = {
  deficitAcumulado: 1172216464039,
  anio2025: { resoluciones: 72, valorAsignado: 2885453519285, pendiente: 1165811950657, pagado: 0 },
  anio2026: { resoluciones: 1, valorAsignado: 6404513382, pendiente: 6404513382, pagado: 0 },
  historico: [],
};

// ─── Page ─────────────────────────────────────────────────────────────────
export default function SubsidiosPage() {
  const { resolvedTheme } = useTheme();
  const T = getNivoTheme(resolvedTheme === "dark");
  const [data, setData] = useState<SubsidiosData>(DEFAULT);
  const [deficitHistorico, setDeficitHistorico] = useState<DeficitHistoricoRow[]>([]);

  useEffect(() => {
    // Fetch resoluciones / pagos
    fetch("/api/subsidios")
      .then((r) => r.json())
      .then((raw) => {
        setData({
          deficitAcumulado: Number(raw.deficitAcumulado) || DEFAULT.deficitAcumulado,
          anio2025: {
            resoluciones: Number(raw.anio2025?.resoluciones) || DEFAULT.anio2025.resoluciones,
            valorAsignado: Number(raw.anio2025?.valorAsignado) || DEFAULT.anio2025.valorAsignado,
            pendiente: Number(raw.anio2025?.pendiente) || DEFAULT.anio2025.pendiente,
            pagado: Number(raw.anio2025?.pagado) || DEFAULT.anio2025.pagado,
          },
          anio2026: {
            resoluciones: Number(raw.anio2026?.resoluciones) || DEFAULT.anio2026.resoluciones,
            valorAsignado: Number(raw.anio2026?.valorAsignado) || DEFAULT.anio2026.valorAsignado,
            pendiente: Number(raw.anio2026?.pendiente) || DEFAULT.anio2026.pendiente,
            pagado: Number(raw.anio2026?.pagado) || DEFAULT.anio2026.pagado,
          },
          historico: (raw.historico || []).map((h: any) => ({
            anio: Number(h.anio) || 0,
            fondo: String(h.fondo),
            valor_asignado: Number(h.valor_asignado) || 0,
            pagado: Number(h.pagado) || 0,
            pendiente: Number(h.pendiente) || 0,
          })),
        });
      })
      .catch(() => {});

    // Fetch histórico FSSRI (déficit acumulado real)
    fetch("/api/subsidios/deficit-historico")
      .then((r) => r.json())
      .then((raw) => {
        if (raw.data && Array.isArray(raw.data)) {
          setDeficitHistorico(raw.data.map((h: any) => ({
            anio: Number(h.anio) || 0,
            subsidios: Number(h.subsidios) || 0,
            contribuciones: Number(h.contribuciones) || 0,
            deficit_anual: Number(h.deficit_anual) || 0,
            deficit_acumulado: Number(h.deficit_acumulado) || 0,
            apropiacion_pgn: Number(h.apropiacion_pgn) || 0,
            recursos_faltantes: Number(h.recursos_faltantes) || 0,
          })));
        }
      })
      .catch(() => {});
  }, []);

  // Valor real más reciente del déficit acumulado (Excel FSSRI)
  const ultimoDeficitFssri = deficitHistorico.length > 0
    ? deficitHistorico[deficitHistorico.length - 1].deficit_acumulado * 1e6  // millones → pesos
    : 0;

  // Datos para la línea de evolución histórica (desde 2020)
  const lineData = [
    {
      id: "Déficit Acumulado",
      color: "#EF4444",
      data: deficitHistorico
        .filter((d) => d.anio >= 2020 && d.deficit_acumulado != null)
        .map((d) => ({
          x: String(d.anio),
          y: +(d.deficit_acumulado / 1e3).toFixed(1), // millones → billones (B)
        })),
    },
  ];

  const barData = [
    {
      anio: "2025",
      Asignado: +(data.anio2025.valorAsignado / 1e9).toFixed(1),
      Pendiente: +(data.anio2025.pendiente / 1e9).toFixed(1),
      Pagado: +(data.anio2025.pagado / 1e9).toFixed(1),
    },
    {
      anio: "2026",
      Asignado: +(data.anio2026.valorAsignado / 1e9).toFixed(1),
      Pendiente: +(data.anio2026.pendiente / 1e9).toFixed(1),
      Pagado: +(data.anio2026.pagado / 1e9).toFixed(1),
    },
  ];

  const resolucionesDonut = [
    { id: "2025", label: "Resoluciones 2025", value: data.anio2025.resoluciones, color: "#F59E0B" },
    { id: "2026", label: "Resoluciones 2026", value: data.anio2026.resoluciones, color: "#8B5CF6" },
  ];
  const totalRes = data.anio2025.resoluciones + data.anio2026.resoluciones;

  // Group historico by fondo
  const fondos = Array.from(new Set(data.historico.map((r) => r.fondo)));
  const anios = Array.from(new Set(data.historico.map((r) => r.anio))).sort();
  const historicoBar = fondos.map((fondo) => {
    const row: Record<string, string | number> = { fondo: fondo.length > 22 ? fondo.slice(0, 22) + "…" : fondo };
    anios.forEach((anio) => {
      const match = data.historico.find((h) => h.fondo === fondo && h.anio === anio);
      row[String(anio)] = match ? +(match.valor_asignado / 1e9).toFixed(1) : 0;
    });
    return row;
  });
  const FONDO_COLORS: Record<string, string> = { "2023": "#06B6D4", "2024": "#F59E0B", "2025": "#8B5CF6", "2026": "#22C55E" };

  return (
    <DashboardLayout title="Subsidios de Energía" subtitle="Déficit acumulado, resoluciones expedidas y valor asignado por vigencia">

      {/* ── Row 1: KPIs principales ── */}
      <div className="grid grid-cols-1 md:grid-cols-2 gap-5 mb-5">
        {/* Total Deuda a la fecha (resoluciones/pagos) */}
        <Card delay={0.05} className="border-red-500/30 bg-gradient-to-br from-red-900/20 to-transparent">
          <span className="text-red-400 font-bold uppercase tracking-widest text-[11px]">TOTAL DEUDA A LA FECHA</span>
          <div className="mt-3 text-3xl font-extrabold text-red-400 leading-none">{fmtBFull(data.deficitAcumulado)}</div>
          <div className="text-[11px] text-theme-muted mt-1">Corte 1 de Abril — Pendiente de desembolso M Hacienda</div>
          <div className="mt-4 h-1.5 rounded-full bg-red-900/30 overflow-hidden">
            <div className="h-full rounded-full bg-gradient-to-r from-red-500 to-red-700" style={{ width: "100%" }} />
          </div>
        </Card>

        {/* Déficit Acumulado FSSRI (Excel histórico) */}
        <Card delay={0.08} className="border-amber-500/30 bg-gradient-to-br from-amber-900/20 to-transparent">
          <span className="text-amber-400 font-bold uppercase tracking-widest text-[11px]">DÉFICIT ACUMULADO FSSRI</span>
          <div className="mt-3 text-3xl font-extrabold text-amber-400 leading-none">
            {ultimoDeficitFssri > 0 ? fmtBFull(ultimoDeficitFssri) : "—"}
          </div>
          <div className="text-[11px] text-theme-muted mt-1">Brecha histórica acumulada 2002-2025 (millones $)</div>
          <div className="mt-4 h-1.5 rounded-full bg-amber-900/30 overflow-hidden">
            <div className="h-full rounded-full bg-gradient-to-r from-amber-500 to-amber-700" style={{ width: "100%" }} />
          </div>
        </Card>
      </div>

      {/* ── Row 2: Evolución histórica del déficit ── */}
      <div className="mb-5">
        {/* Gráfica evolución histórica del déficit */}
        {lineData[0].data.length > 0 && (
          <Card delay={0.1}>
            <span className="text-red-400 font-bold uppercase tracking-widest text-[11px]">EVOLUCIÓN HISTÓRICA DEL DÉFICIT</span>
            <div className="h-[280px] mt-4">
              <ResponsiveLine
                data={lineData}
                theme={T}
                margin={{ top: 10, right: 30, bottom: 40, left: 60 }}
                xScale={{ type: "point" }}
                yScale={{ type: "linear", min: 0, max: "auto", stacked: false, reverse: false }}
                curve="monotoneX"
                axisTop={null}
                axisRight={null}
                axisBottom={{
                  tickSize: 0,
                  tickPadding: 12,
                  tickRotation: 0,
                }}
                axisLeft={{
                  tickSize: 0,
                  tickPadding: 10,
                  format: (v) => `${v}B`,
                }}
                colors={["#EF4444"]}
                lineWidth={3}
                pointSize={6}
                pointColor="#EF4444"
                pointBorderWidth={2}
                pointBorderColor="#fff"
                enableArea={true}
                areaOpacity={0.15}
                enableGridX={false}
                enableGridY={true}
                useMesh={true}
                tooltip={({ point }) => (
                  <div style={{ padding: "8px 12px", background: "#1E293B", border: "1px solid #334155", borderRadius: 8, color: "#E2E8F0", fontSize: 12 }}>
                    <strong>{point.data.x}</strong><br />
                    Déficit Acumulado: <strong>{fmtCOP(Number(point.data.y) * 1e12)}</strong>
                  </div>
                )}
                legends={[]}
              />
            </div>
          </Card>
        )}
      </div>

      {/* ── Row 2: Vigencias 2025 / 2026 ── */}
      <div className="grid grid-cols-1 md:grid-cols-2 gap-5 mb-5">
        {/* 2025 */}
        <Card delay={0.15}>
          <div className="flex items-center gap-2 mb-3">
            <span className="text-amber-400 font-bold uppercase tracking-widest text-[11px]">VIGENCIA 2025</span>
            <span className="bg-amber-400/10 border border-amber-400/30 text-amber-400 text-[10px] font-semibold px-2 py-0.5 rounded-full">{data.anio2025.resoluciones} res.</span>
          </div>
          <div className="grid grid-cols-2 gap-2">
            <KpiChip label="Valor Asignado" value={fmtBFull(data.anio2025.valorAsignado)} accent />
            <KpiChip label="Pendiente" value={fmtBFull(data.anio2025.pendiente)} />
            <KpiChip label="Pagado" value={fmtBFull(data.anio2025.pagado)} />
            <KpiChip label="Resoluciones" value={data.anio2025.resoluciones} accent />
          </div>
        </Card>

        {/* 2026 */}
        <Card delay={0.2}>
          <div className="flex items-center gap-2 mb-3">
            <span className="text-purple-400 font-bold uppercase tracking-widest text-[11px]">VIGENCIA 2026</span>
            <span className="bg-purple-400/10 border border-purple-400/30 text-purple-400 text-[10px] font-semibold px-2 py-0.5 rounded-full">{data.anio2026.resoluciones} res.</span>
          </div>
          <div className="grid grid-cols-2 gap-2">
            <KpiChip label="Valor Asignado" value={fmtBFull(data.anio2026.valorAsignado)} accent />
            <KpiChip label="Pendiente" value={fmtBFull(data.anio2026.pendiente)} />
            <KpiChip label="Pagado" value={fmtBFull(data.anio2026.pagado)} />
            <KpiChip label="Resoluciones" value={data.anio2026.resoluciones} accent />
          </div>
        </Card>
      </div>

      {/* ── Row 3: Bar grouped + Resoluciones donut ── */}
      <div className="grid grid-cols-1 lg:grid-cols-5 gap-5 mb-5">
        <Card delay={0.25} className="lg:col-span-3">
          <span className="text-amber-400 font-bold uppercase tracking-widest text-[11px]">VALOR ASIGNADO Y PENDIENTE (Miles de millones $)</span>
          <div className="h-[240px] mt-4">
            <ResponsiveBar
              data={barData}
              keys={["Asignado", "Pendiente", "Pagado"]}
              indexBy="anio"
              theme={T}
              margin={{ top: 8, right: 100, bottom: 30, left: 50 }}
              groupMode="grouped"
              valueScale={{ type: "linear" }}
              indexScale={{ type: "band", round: true }}
              colors={["#F59E0B", "#EF4444", "#22C55E"]}
              borderRadius={3}
              padding={0.25}
              innerPadding={3}
              enableLabel={false}
              enableGridX={false}
              axisTop={null}
              axisRight={null}
              axisLeft={{ tickSize: 0, tickPadding: 6, format: (v) => `$${v}B` }}
              axisBottom={{ tickSize: 0, tickPadding: 8 }}
              legends={[{
                dataFrom: "keys" as const, anchor: "right" as const, direction: "column" as const, justify: false,
                translateX: 95, translateY: 0, itemsSpacing: 5, itemWidth: 90, itemHeight: 14,
                itemTextColor: "#94A3B8", symbolSize: 8, symbolShape: "circle" as const,
              }]}
              tooltip={({ id, value, indexValue }) => (
                <div style={{ padding: "8px 12px", background: "#1E293B", border: "1px solid #334155", borderRadius: 8, color: "#E2E8F0", fontSize: 12 }}>
                  {indexValue} — {id}: <strong>{fmtCOP(value * 1e9)}</strong>
                </div>
              )}
            />
          </div>
        </Card>

        <Card delay={0.3} className="lg:col-span-2">
          <span className="text-amber-400 font-bold uppercase tracking-widest text-[11px]">RESOLUCIONES EXPEDIDAS</span>
          <div className="relative h-[240px] mt-3">
            <ResponsivePie
              data={resolucionesDonut}
              theme={T}
              margin={{ top: 10, right: 10, bottom: 10, left: 10 }}
              innerRadius={0.6}
              padAngle={2}
              cornerRadius={3}
              activeOuterRadiusOffset={5}
              colors={{ datum: "data.color" }}
              borderWidth={0}
              enableArcLinkLabels={false}
              arcLabelsSkipAngle={15}
              arcLabelsTextColor="#fff"
              arcLabelsRadiusOffset={0.75}
              tooltip={({ datum }) => (
                <div style={{ padding: "8px 12px", background: "#1E293B", border: "1px solid #334155", borderRadius: 8, color: "#E2E8F0", fontSize: 12 }}>
                  <span style={{ display: "inline-block", width: 8, height: 8, borderRadius: "50%", background: datum.color, marginRight: 6 }} />
                  {datum.label}: <strong>{datum.value}</strong>
                </div>
              )}
            />
            <div className="absolute inset-0 flex flex-col items-center justify-center pointer-events-none">
              <span className="text-2xl font-bold text-theme-primary">{totalRes}</span>
              <span className="text-[9px] text-theme-secondary">resoluciones</span>
            </div>
          </div>
        </Card>
      </div>

      {/* ── Row 4: Histórico por fondo ── */}
      {historicoBar.length > 0 && (
        <Card delay={0.35}>
          <span className="text-amber-400 font-bold uppercase tracking-widest text-[11px]">HISTÓRICO POR FONDO (Miles de millones $)</span>
          <div className="h-[260px] mt-4">
            <ResponsiveBar
              data={historicoBar}
              keys={anios.map(String)}
              indexBy="fondo"
              theme={T}
              margin={{ top: 8, right: 110, bottom: 20, left: 140 }}
              layout="horizontal"
              groupMode="grouped"
              valueScale={{ type: "linear" }}
              indexScale={{ type: "band", round: true }}
              colors={({ id }) => FONDO_COLORS[String(id)] ?? "#64748B"}
              borderRadius={3}
              padding={0.25}
              innerPadding={2}
              enableLabel={false}
              enableGridX
              enableGridY={false}
              axisTop={null}
              axisRight={null}
              axisLeft={{ tickSize: 0, tickPadding: 6 }}
              axisBottom={{ tickSize: 0, tickPadding: 5, format: (v) => `$${v}B` }}
              legends={[{
                dataFrom: "keys" as const, anchor: "right" as const, direction: "column" as const, justify: false,
                translateX: 105, translateY: 0, itemsSpacing: 5, itemWidth: 100, itemHeight: 14,
                itemTextColor: "#94A3B8", symbolSize: 8, symbolShape: "circle" as const,
              }]}
              tooltip={({ id, value, indexValue }) => (
                <div style={{ padding: "8px 12px", background: "#1E293B", border: "1px solid #334155", borderRadius: 8, color: "#E2E8F0", fontSize: 12 }}>
                  {indexValue} ({id}): <strong>{fmtCOP(value * 1e9)}</strong>
                </div>
              )}
            />
          </div>
        </Card>
      )}

      <p className="text-center text-[10px] text-theme-muted mt-10">
        Ministerio de Minas y Energía · Dirección de Energía Eléctrica · 2026
      </p>
    </DashboardLayout>
  );
}
